{
  "name": "pdfly",
  "version": "1.0.0",
  "description": "PDFly - A Fully Functional iLovePDF Alternative with Genuine Document Engines",
  "scripts": {
    "start:backend": "PYTHONPATH=backend ./.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "start:frontend": "npm run --prefix frontend start",
    "dev:backend": "PYTHONPATH=backend ./.venv/bin/uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "npm run --prefix frontend dev",
    "build": "npm run --prefix frontend build",
    "test": "PYTHONPATH=backend ./.venv/bin/pytest backend/tests/test_all_features.py backend/tests/test_edge_cases.py -v"
  },
  "keywords": [
    "pdf",
    "ilovepdf",
    "document-processing",
    "libreoffice",
    "mupdf",
    "ocr",
    "tesseract"
  ],
  "author": "sanstack256",
  "license": "MIT"
}
